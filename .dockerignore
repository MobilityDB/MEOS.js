# Build outputs / generated files. core/c-src/bindings.c is NOT excluded: it is
# the committed projection this image compiles, not something the image produces.
node_modules/
wasm/
dist/
coverage/

# Docs / tests are not needed for the WASM build
docs/
test/

# Editor / git / OS
.git/
.gitignore
.vscode/
.idea/
.DS_Store

# Logs
*.log

# Markdown / config files unused by the build
README.md
*.md
