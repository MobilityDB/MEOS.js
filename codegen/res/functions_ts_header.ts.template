import { getModule } from '../runtime/meos.js';

// WASM linear memory address, held as a JS number (safe up to 2^53).
export type Ptr = number;

// PostgreSQL TimestampTz - microseconds since 2000-01-01 UTC, an integer of
// 64 bits and thus a bigint, as every integer of 64 bits the binding passes
export type TimestampTz = bigint;

// PostgreSQL DateADT - days since 2000-01-01
export type DateADT = number;

function call<T>(
	name: string,
	ret: 'number' | 'bigint' | 'string' | 'boolean' | null,
	argTypes: ('number' | 'string' | 'boolean' | 'bigint')[],
	args: unknown[]
): T {
	// eslint-disable-next-line @typescript-eslint/no-explicit-any
	return getModule().ccall(name, ret as any, argTypes as any, args) as T;
}

// --- wasm64 pointer support ---
//
// MEOS.js targets wasm64 (MEMORY64=1) exclusively. Emscripten represents
// pointer arguments and return values as JS BigInt with ccall. The helpers
// below centralise that conversion so every generated wrapper stays uniform.

/** ccall arg-type tag for a Ptr parameter (always 'bigint' in wasm64). */
export function ptrArgType(): 'bigint' { return 'bigint'; }

/** Converts a Ptr to the BigInt value ccall expects in wasm64. */
export function ptrArgVal(p: Ptr): bigint { return BigInt(p); }

/** Calls a MEOS function that returns a Ptr (BigInt from ccall → number). */
export function callPtr(
	name: string,
	argTypes: ('number' | 'string' | 'boolean' | 'bigint')[],
	args: unknown[]
): Ptr {
	// eslint-disable-next-line @typescript-eslint/no-explicit-any
	return Number(getModule().ccall(name, 'bigint' as any, argTypes as any, args) as bigint);
}

// --- Error handling ---
//
// errlevel mirrors PostgreSQL severity constants: NOTICE=18, WARNING=19, ERROR=21.
// After every generated wrapper call, checkMeosError() reads the C globals written
// by _meos_error_handler (registered in meos_init_lib) and throws if errcode != 0.
//
// Typed exceptions (MeosInternalError, MeosInvalidArgError, …) are defined in
// src/errors.ts and dispatched via makeMeosException().

import { makeMeosException, MEOS_NOTICE, MEOS_WARNING, MeosException } from './errors.js';
export * from './errors.js';

// MeosError kept as alias for backward compatibility.
export { MeosException as MeosError };

export function checkMeosError(): void {
	const code  = call<number>('meos_err_code',  'number', [], []);
	const level = call<number>('meos_err_level', 'number', [], []);
	if (code === 0 && level === 0) return;
	const msg = call<string>('meos_err_msg', 'string', [], []);
	call<void>('meos_err_clear', null, [], []);
	if (level === MEOS_NOTICE) {
		console.info(`MEOS notice [${code}]: ${msg}`);
	} else if (level === MEOS_WARNING) {
		console.warn(`MEOS warning [${code}]: ${msg}`);
	} else {
		throw makeMeosException(code, level, msg);
	}
}

// --- Hand-written wrappers (special logic) ---

/**
 * Free a MEOS-allocated pointer.
 *
 * The one wrapper that deliberately does NOT call checkMeosError(): the check
 * clears the error state as it reads it, so on a cleanup path it would consume
 * a pending error that the next real call is meant to raise, or throw out of a
 * `finally` and mask the failure being cleaned up after. Freeing reports
 * nothing of its own.
 */
export function meos_free(ptr: Ptr): void {
	call<void>('meos_free', null, [ptrArgType()], [ptrArgVal(ptr)]);
}

const UTF8 = new TextDecoder();

/**
 * The string a MEOS writer answers, read for the size it states and freed.
 *
 * `write(sizeOut)` receives the address of a `size_t` the writer fills with the
 * size of the string it returns, its terminator included, as wkb.ts's `readWkb`
 * gives a byte buffer's. The string and the size slot are freed with `_meos_free`.
 * A null string, for which MEOS wrote no size, answers '', as ccall's 'string'
 * return answers it.
 */
export function readString(write: (sizeOut: Ptr) => Ptr): string {
	const mod = getModule();
	// size_t is 8 bytes in wasm64
	const sizeOut: Ptr = mod.allocate(new Uint8Array(8), mod.ALLOC_NORMAL) as Ptr;
	let str: Ptr = 0;
	try {
		str = write(sizeOut);
		checkMeosError();
		if (!str) return '';
		// Read the heap after the call: a growth during it replaces the view
		const heap = mod.HEAPU8;
		const size = Number(
			new DataView(heap.buffer, heap.byteOffset + sizeOut, 8).getBigUint64(0, /* littleEndian */ true)
		);
		return UTF8.decode(heap.subarray(str, str + size - 1));
	} finally {
		if (str) (mod._meos_free as (p: bigint) => void)(BigInt(str));
		(mod._meos_free as (p: bigint) => void)(BigInt(sizeOut));
	}
}

// --- Casts of the time types of JavaScript through the MEOS conversions ---
//
// Each cast calls the generated wrapper of a MEOS conversion and builds the
// JavaScript value with its constructor, as the casts of PyMEOS-CFFI, JMEOS,
// GoMEOS and MEOS.NET do, under the same names. A Date counts milliseconds from
// the Unix epoch, coarser than MEOS's microseconds: a timestamp read as a Date
// drops the microseconds below a millisecond toward the past, as MobilityNebula
// reads its milliseconds, and a Date read as a timestamp is exact. JavaScript
// holds an interval, a time and a time with time zone in no type of its own, so
// they cast to and from their parts.

/** The parts of an interval: months, days and microseconds. */
export interface IntervalParts { months: number; days: number; microseconds: bigint; }

/** The parts of a time with time zone: its microseconds from midnight and its
 * offset in seconds east of UTC. */
export interface TimetzParts { microseconds: bigint; offsetSeconds: number; }

/** Calls `fill` with a slot of `bytes` bytes MEOS writes, reads it, frees it. */
function withSlot<T>(bytes: number, fill: (slot: Ptr) => void, read: (v: DataView) => T): T {
	const mod = getModule();
	const slot: Ptr = mod.allocate(new Uint8Array(bytes), mod.ALLOC_NORMAL) as Ptr;
	try {
		fill(slot);
		// Read the heap after the call: a growth during it replaces the view
		const heap = mod.HEAPU8;
		return read(new DataView(heap.buffer, heap.byteOffset + slot, bytes));
	} finally {
		(mod._meos_free as (p: bigint) => void)(BigInt(slot));
	}
}

/** Floor division of a bigint by a positive bigint. */
const floorDiv = (a: bigint, b: bigint): bigint => (a - (((a % b) + b) % b)) / b;

/** A Date as a timestamptz, through unix_us_to_timestamptz. */
export function datetime_to_timestamptz(d: Date): TimestampTz {
	return unix_us_to_timestamptz(BigInt(d.getTime()) * 1000n);
}

/** A timestamptz as a Date, through timestamptz_to_unix_us, the microseconds
 * below a millisecond dropped toward the past. */
export function timestamptz_to_datetime(ts: TimestampTz): Date {
	return new Date(Number(floorDiv(timestamptz_to_unix_us(ts), 1000n)));
}

/** The clock of a Date in UTC as a timestamp, through unix_us_to_timestamp. */
export function datetime_to_timestamp(d: Date): bigint {
	return unix_us_to_timestamp(BigInt(d.getTime()) * 1000n);
}

/** A timestamp as a Date whose UTC clock reads it, through timestamp_to_unix_us,
 * the microseconds below a millisecond dropped toward the past. */
export function timestamp_to_datetime(ts: bigint): Date {
	return new Date(Number(floorDiv(timestamp_to_unix_us(ts), 1000n)));
}

/** The date of a Date in UTC as a date, through unix_days_to_date. */
export function date_to_date_adt(d: Date): DateADT {
	return unix_days_to_date(Math.floor(d.getTime() / 86_400_000));
}

/** A date as the Date of its midnight UTC, through date_to_unix_days. */
export function date_adt_to_date(d: DateADT): Date {
	return new Date(date_to_unix_days(d) * 86_400_000);
}

/** Parts as an interval, through interval_from_parts. */
export function timedelta_to_interval(p: IntervalParts): Ptr {
	return interval_from_parts(p.months, p.days, p.microseconds);
}

/** An interval as its parts, through interval_to_parts. */
export function interval_to_timedelta(interv: Ptr): IntervalParts {
	return withSlot(16, slot => interval_to_parts(interv, slot, slot + 4, slot + 8),
		v => ({ months: v.getInt32(0, true), days: v.getInt32(4, true), microseconds: v.getBigInt64(8, true) }));
}

/** Microseconds from midnight as a time, through time_from_parts. */
export function time_to_time_adt(microseconds: bigint): bigint {
	return time_from_parts(microseconds);
}

/** A time as its microseconds from midnight, through time_to_parts. */
export function time_adt_to_time(t: bigint): bigint {
	return withSlot(8, slot => time_to_parts(t, slot), v => v.getBigInt64(0, true));
}

/** Parts as a time with time zone, through timetz_from_parts. */
export function timetz_to_timetz_adt(p: TimetzParts): Ptr {
	return timetz_from_parts(p.microseconds, p.offsetSeconds);
}

/** A time with time zone as its parts, through timetz_to_parts. */
export function timetz_adt_to_timetz(timetz: Ptr): TimetzParts {
	return withSlot(16, slot => timetz_to_parts(timetz, slot, slot + 8),
		v => ({ microseconds: v.getBigInt64(0, true), offsetSeconds: v.getInt32(8, true) }));
}

/**
 * The C string a wrapper allocates, read and freed: what MEOS answers through
 * a `text **` beside a `bool`, which the C wrapper converts with text_to_cstring.
 * A NULL pointer is the answer MEOS did not find, so it answers null where
 * ccall's 'string' return would answer ''.
 */
export function takeString(ptr: Ptr): string | null {
	if (!ptr) return null;
	const mod = getModule();
	try {
		return mod.UTF8ToString(ptr);
	} finally {
		(mod._meos_free as (p: bigint) => void)(BigInt(ptr));
	}
}

// --- Generated wrappers ---
